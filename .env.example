# Copy this file to .env and fill your own values. Never commit .env.

# ── Vector store ─────────────────────────────────────────────────────
# Qdrant Cloud / server (approximate HNSW search):
QDRANT_URL=
QDRANT_API_KEY=
# Or a local store (exact search), used when QDRANT_URL is empty:
#   ":memory:"  for an in-process store, or a folder path for on-disk storage
QDRANT_LOCATION=

# ── LLM provider for Layers A/B/C and the benchmark reader ───────────
# "openai" | "gemini" | empty (auto: Gemini if GEMINI_API_KEY is set, else OpenAI)
DARS_LLM_PROVIDER=

# OpenAI (reader = gpt-4o-mini; judge/compressor/reformulator = gpt-4.1-nano)
OPEN_AI_API_KEY=
# DARS_OPENAI_READER_MODEL=gpt-4o-mini-2024-07-18
# DARS_OPENAI_AUX_MODEL=gpt-4.1-nano-2025-04-14
# Optional: a .env file outside the repo that holds OPEN_AI_API_KEY
DARS_ENV_FILE=

# Gemini (legacy provider)
GEMINI_API_KEY=
GEMINI_PROJECT_NUMBER=
GEMINI_MODEL=gemini-2.5-flash

# Training Group — selects the GOAL_VECTOR preset for predictive scoring (P)
# Options: "MSC" (Multi-Session Chat) | "ALFWorld" (household tasks)
TRAINING_GROUP=ALFWorld
# Or override with a custom goal description:
# GOAL_DESCRIPTION=Your custom goal description here
